# ───────────────────────────────────────────────────────────────────────────
# DreamPalm Uji — Environment Variables
# Salin file ini sebagai .env dan isi nilainya sesuai environment.
# Jangan commit file .env ke repository.
# ───────────────────────────────────────────────────────────────────────────

# URL live stream MAPIR (di-expose ke browser — gunakan NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_MAPIR_STREAM_URL=

# Base URL Capture API (Raspberry Pi / server drone)
# Contoh: https://api.dreampalm.id/v1/mapir
DREAMPALM_API_URL=

# API key untuk Capture API — SERVER ONLY, jangan prefix NEXT_PUBLIC_
DREAMPALM_API_KEY=

# Base URL FastAPI ML Inference (internal VPS, tidak boleh publik)
# Contoh konfigurasi pada VPS:
# FASTAPI_URL=http://127.0.0.1:8002
FASTAPI_URL=

# PostgreSQL connection string — SERVER ONLY, jangan prefix NEXT_PUBLIC_
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Contoh konfigurasi pada VPS:
# DATABASE_URL=postgresql://dreampalm_uji:<password>@127.0.0.1:5432/db_dreampalm
DATABASE_URL=

# Direktori root penyimpanan file — SERVER ONLY
# Contoh konfigurasi pada VPS:
# DREAMPALM_STORAGE_ROOT=/srv/dreampalm-storage/uji
# Untuk pengujian lokal, gunakan folder storage di root proyek:
DREAMPALM_STORAGE_ROOT=./storage

# Supabase Storage URL (konfigurasi lama — masih digunakan oleh next.config.ts
# untuk remotePatterns. Jangan hapus sebelum integrasi backend baru selesai.)
SUPABASE_STORAGE_URL=
